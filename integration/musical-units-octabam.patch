diff --git a/tools/site/capture_manual.py b/tools/site/capture_manual.py
index d9099fc4..b0e762d9 100644
--- a/tools/site/capture_manual.py
+++ b/tools/site/capture_manual.py
@@ -315,6 +315,100 @@ def capture_midi_scales(p,r):
     shot(p,'midi-scales','c-mixolydian','MIDI ARP SETUP: C Mixolydian selected with encoder F.',r)
 
 
+def capture_musical_units(p,r):
+    """Actual native cells: exact, intermediate, setup, MIDI and held locks."""
+    bank=p.long(0x46c82456)
+    screens={}
+    def set_raw(knob,offset,want,scale=1):
+        # Editors have different fine/coarse resolutions; verify the actual
+        # Part byte after driving the native encoder, never assume 1:1 steps.
+        address=bank+offset
+        got=p.peek(address,1)[0]
+        delta=max(-127,min(127,round((want-got)*scale)))
+        if delta:
+            p.proc.command(f'knob {0x30+knob:#x} {delta}','ok');p.run(80)
+        for _ in range(512):
+            got=p.peek(address,1)[0]
+            if got==want:return
+            p.proc.command(f'knob {0x30+knob:#x} {1 if got<want else -1}','ok');p.run(60)
+        raise AssertionError(('encoder value',knob,hex(offset),got,want))
+    def capture(name,caption,midi=False,speed=None,mult=5):
+        if speed is not None:
+            spd=0x8f168 if midi else 0x8ee9a
+            mul=0x8f280 if midi else 0x8f08a
+            assert p.peek(bank+spd,1)[0]==speed, (name,'SPD')
+            assert p.peek(bank+mul,1)[0]==mult, (name,'MULT')
+        screens[name]=p.link.lcd_rows()
+        if name=='audio-lock':
+            normal=screens['audio-ms'];held=screens[name]
+            assert all(held[y][x] != normal[y][x] for y in range(22,27) for x in range(60,79)), 'held label must invert all 19 pixels'
+            assert all(held[y][x] == normal[y][x] for y in range(29,56) for x in range(60,119)), 'neighboring depth cells changed'
+        if name=='note-lock':
+            normal=screens['note-ms'];held=screens[name]
+            assert all(held[y][x] != normal[y][x] for y in range(16,21) for x in range(100,119)), 'held numeric label must invert all 19 pixels'
+        shot(p,'musical-units',name,caption,r)
+    press(p,'t1');press(p,'pg_lfo')
+    enc(p,0,-127);enc(p,0,64)
+    capture('audio-division','Audio LFO: SPD 64, MULT 32 gives a 1/16 cycle.',speed=64)
+    enc(p,0,1)
+    capture('audio-ms','The next speed remains available: SPD 65 displays 123ms at 120 BPM.',speed=65)
+    enc(p,0,31)
+    capture('audio-triplet','SPD 96, MULT 32: an exact sixteenth-note triplet, 1/16T.',speed=96)
+    enc(p,0,-127)
+    capture('audio-stop','Zero speed displays STOP.',speed=0)
+    enc(p,0,63)
+    p.chord('func','pg_lfo')
+    bank=p.long(0x46c82456)
+    def multiplier(want):
+        p.proc.command('knob 0x32 -127','ok');p.run(60)
+        if want:
+            p.proc.command(f'knob 0x32 {want*4}','ok');p.run(60)
+        close(p)
+        got=p.peek(bank+0x8f08a,1)[0]
+        assert got==want, ('LFO MULT',got,want)
+        p.chord('func','pg_lfo')
+    multiplier(0);enc(p,4,1);enc(p,4,-1)
+    capture('audio-seconds','LFO SETUP: SPD 63, MULT 1 gives a 4.06s cycle at 120 BPM.',speed=63,mult=0)
+    multiplier(5);close(p)
+    enc(p,0,1)
+    press(p,'rec');press(p,'trig1');p.key('trig1',True);p.run(100);enc(p,0,1)
+    capture('audio-lock','Held trig: a speed lock displays its own 123ms cycle.')
+    p.key('trig1',False);p.run(100);press(p,'rec')
+    press(p,'midi');press(p,'pg_lfo');enc(p,0,-127);enc(p,0,64)
+    capture('midi-division','MIDI LFO: the same 1/16 cycle notation.',speed=64,midi=True)
+    p.chord('func','pg_lfo');enc(p,4,1)
+    capture('midi-setup','MIDI LFO SETUP: the intermediate speed displays 123ms.',speed=65,midi=True)
+    close(p);press(p,'pg_playback');set_raw(2,0x8f164,6,4)
+    capture('note-division','MIDI NOTE LEN: six clock ticks displays 1/16.')
+    set_raw(2,0x8f164,7,4)
+    capture('note-ms','MIDI NOTE LEN: the next setting displays 146ms at 120 BPM.')
+    set_raw(2,0x8f164,6,4)
+    press(p,'rec');press(p,'trig2');p.key('trig2',True);p.run(100);enc(p,2,1)
+    capture('note-lock','Held MIDI trig: note length retains its numeric widget and full-width label.')
+    p.key('trig2',False);p.run(100);press(p,'rec')
+    press(p,'pg_amp');set_raw(3,0x8f171,5,4/3)
+    set_raw(5,0x8f173,7);set_raw(5,0x8f173,6)
+    set_raw(0,0x8f16e,77);set_raw(0,0x8f16e,76)
+    capture('arp-division','ARP: TRAN is 12st; SPD and NLEN both display 1/16.')
+    set_raw(3,0x8f171,6,4/3);set_raw(5,0x8f173,7)
+    set_raw(0,0x8f16e,77);set_raw(0,0x8f16e,76)
+    capture('arp-ms','ARP: intermediate speed and note length both display 146ms at 120 BPM.')
+    press(p,'midi');press(p,'pg_playback')
+    machine=p.peek(bank+0x8eda2,1)[0]
+    assert machine in (0,1), ('RTIM needs Static/Flex',machine)
+    retrig=0x8edaa+machine*6+5
+    set_raw(5,retrig,91)
+    capture('retrig-division','Sample retrigger interval RTIM displays 1/16.')
+    set_raw(5,retrig,92)
+    capture('retrig-ms','The next RTIM setting displays 132ms at 120 BPM.')
+    p.chord('func','reccd');set_raw(0,0x8f388,16,128/113);set_raw(1,0x8f389,17,128/113)
+    capture('recorder-fades','Recorder FIN displays 1/16; FOUT displays 133ms at 120 BPM.')
+    close(p);press(p,'pg_fx2');enc(p,0,-127);enc(p,0,7)
+    capture('delay-division','Synced Echo Freeze TIME 8 displays 1/16.')
+    enc(p,0,1)
+    capture('delay-ms','Synced TIME 9 displays 141ms at 120 BPM.')
+
+
